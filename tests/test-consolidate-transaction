    }
    original_write = tx._write_receipt
    writes = 0

    def crash_before_target_receipt(receipt_root, transaction_id, receipt):
        global writes
        writes += 1
        if writes == 2:
            raise RuntimeError("simulated crash")
        original_write(receipt_root, transaction_id, receipt)

    tx._write_receipt = crash_before_target_receipt
    crashed = False
    try:
        tx.apply_plan(crash_plan, root)
    except RuntimeError:
        crashed = True
    finally:
        tx._write_receipt = original_write
    check("simulated crash lands between replacement and receipt update",
          crashed and
          "### learned" in (root / "memory/learnings.md").read_text() and
          "status: open" in (root / "workspace/demo/intake.md").read_text())
    reconciled = tx.reconcile_receipt(
        tx.receipt_path(root, crash_plan["transaction_id"]), root
    )
    resumed = tx.apply_plan(crash_plan, root)
    check("reconciliation makes crash-window result resumable",
          reconciled["reconciliation"]["status"] == "partial_ready" and
          resumed["status"] == "complete" and
          "status: drained" in (root / "workspace/demo/intake.md").read_text())

