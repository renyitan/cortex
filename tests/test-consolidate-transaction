passed = failed = 0


def check(name, condition):
    global passed, failed
    if condition:
        passed += 1
        print(f"  PASS  {name}")
    else:
        failed += 1
        print(f"  FAIL  {name}")


def expect_error(name, code, action):
    try:
        action()
    except tx.TransactionError as exc:
        check(name, exc.code == code)
        if exc.code != code:
            print(f"        expected {code}, got {exc.code}")
    else:
        check(name, False)


def fixture(root: Path):
    (root / "memory").mkdir()
    (root / "workspace/demo").mkdir(parents=True)
    (root / "memory/learnings.md").write_text("# Learnings\n\n" + BASE_RECORD)
    (root / "memory/decisions.md").write_text("# Decisions\n")
    (root / "workspace/demo/episode.md").write_text("# Episode\n")
    line = (
        "- captured: 2026-07-01  status: open  "
        "note: private transaction fixture"
    )
    (root / "workspace/demo/intake.md").write_text(
        "# intake\n\n"
        "Schema: `- captured: <date>  status: <open|drained>`\n\n"
        + line + "\n"
    )
    return line


def draft(root: Path, transaction_id="tx-fixture"):
    line = next(
        line
        for line in (root / "workspace/demo/intake.md").read_text().splitlines()
        if line.startswith("- captured:")
    )
    candidate = tx.intake_ref("workspace/demo/intake.md", line)
    return {
        "schema": tx.PLAN_SCHEMA,
        "transaction_id": transaction_id,
        "created_at": "2026-07-01T12:00:00Z",
        "proposer": "model",
        "origin": "episode:demo",
        "run_kind": "done",
        "candidate_refs": [candidate],
        "evidence_refs": ["workspace/demo/episode.md"],
        "approval": {"status": "pending", "approver_class": None},
        "operations": [
            {
                "index": 0,
                "op": "append_record",
                "target": "memory/learnings.md",
                "record": LEARNED_RECORD,
            },
            {
                "index": 1,
                "op": "append_record",
                "target": "memory/learnings.md",
                "record": COMPANION_RECORD,
            },
            {
                "index": 2,
                "op": "intake_status",
                "target": "workspace/demo/intake.md",
                "candidate_ref": candidate,
                "from": "open",
                "to": "drained",
                "derives_to": "learned",
            },
        ],
    }


