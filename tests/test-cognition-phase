def check(name, condition):
    global passed, failed
    if condition:
        passed += 1
        print(f"  PASS  {name}")
    else:
        failed += 1
        print(f"  FAIL  {name}")


def environment(root: Path, **changes) -> dict:
    values = dict(
        os.environ,
        CORTEX_REPO_ROOT=str(root),
        CORTEX_EVENT_REPO_ROOT=str(root),
        CORTEX_EVENTS_FILE=".cortex/events.jsonl",
        CORTEX_PHASE_TIME=TIME0,
        CORTEX_EVENT_TIME=TIME0,
        CORTEX_PHASE_LEASE_SECONDS="30",
    )
    values.update({key: str(value) for key, value in changes.items()})
    return values


def run(root: Path, *arguments: str, **changes):
    process = subprocess.run(
        [str(TOOL), *arguments],
        env=environment(root, **changes),
        text=True,
        capture_output=True,
        check=False,
    )
    payload = json.loads(process.stdout) if process.stdout.strip() else None
    return process, payload


def expected(root: Path, lane: str, owner: str = OWNER, **options):
    arguments = [
        "expect", "--lane-id", lane, "--owner-id", owner,
        "--phase", options.get("phase", "wake"),
        "--skill", options.get("skill", "recall"),
        "--trigger", options.get("trigger", "session_start"),
        "--origin", options.get("origin", "harness"),
        "--requirement", options.get("requirement", "required"),
        "--enforcement", options.get("enforcement", "enforced"),
        "--effect", options.get("effect", "none"),
    ]
    if options.get("if_absent"):
        arguments.append("--if-absent")
    return run(root, *arguments, **options.get("env", {}))


def started(
    root: Path,
    lane: str,
    owner: str = OWNER,
    expectation_id: str | None = None,
    **options,
):
    arguments = ["start"]
    if options.get("receipt_id"):
        arguments.extend(["--receipt-id", options["receipt_id"]])
    else:
        arguments.extend(["--lane-id", lane, "--owner-id", owner])
    arguments.extend([
        "--phase", options.get("phase", "wake"),
        "--skill", options.get("skill", "recall"),
        "--trigger", options.get("trigger", "session_start"),
        "--origin", options.get("origin", "runtime"),
        "--requirement", options.get("requirement", "required"),
        "--enforcement", options.get("enforcement", "model_owned"),
        "--effect", options.get("effect", "none"),
    ])
    if expectation_id:
        arguments.extend(["--expectation-id", expectation_id])
    if options.get("parent"):
        arguments.extend([
            "--parent-phase-instance-id", options["parent"]
        ])
    return run(root, *arguments, **options.get("env", {}))


def events(root: Path) -> list[dict]:
    path = root / ".cortex/events.jsonl"
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines()]


