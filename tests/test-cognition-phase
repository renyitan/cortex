with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    _, phase = started(root, "lane-context")
    context = phase["environment"]
    exact = subprocess.run(
        [
            str(EVENT_TOOL), "emit", "retrieval.search", "ok",
            "--attribute", "mode=bm25", "--attribute", "scope=global",
            "--hash", "query_sha256=" + "a" * 64,
            "--phase-instance-id", context["CORTEX_PHASE_INSTANCE_ID"],
            "--phase-start-run-id",
            context["CORTEX_PHASE_START_RUN_ID"],
            "--phase", context["CORTEX_PHASE_NAME"],
            "--skill", context["CORTEX_PHASE_SKILL"],
            "--phase-receipt-id",
            context["CORTEX_PHASE_RECEIPT_ID"],
            "--json",
        ],
        env=environment(root),
        text=True,
        capture_output=True,
        check=False,
    )
    exact_event = json.loads(exact.stdout)
    unavailable = subprocess.run(
        [
            str(EVENT_TOOL), "emit", "retrieval.fetch", "ok",
            "--phase-instance-id", "3" * 32,
            "--phase-start-run-id",
            context["CORTEX_PHASE_START_RUN_ID"],
            "--phase", context["CORTEX_PHASE_NAME"],
            "--skill", context["CORTEX_PHASE_SKILL"],
            "--phase-receipt-id",
            context["CORTEX_PHASE_RECEIPT_ID"],
            "--json",
        ],
        env=environment(root),
        text=True,
        capture_output=True,
        check=False,
    )
    unavailable_event = json.loads(unavailable.stdout)
    check("exact runtime context parents mechanism event",
          exact.returncode == 0 and
          exact_event["parent_run_id"] ==
          context["CORTEX_PHASE_START_RUN_ID"] and
          exact_event["attributes"]["phase_instance_id"] ==
          context["CORTEX_PHASE_INSTANCE_ID"] and
          exact_event["attributes"]["correlation"] == "exact" and
          context["CORTEX_PHASE_RECEIPT_ID"] not in
          json.dumps(exact_event))
    check("mismatched runtime context preserves uncorrelated event",
          unavailable.returncode == 0 and
          unavailable_event["parent_run_id"] is None and
          unavailable_event["attributes"]["correlation"] ==
          "unavailable" and
          unavailable_event["attributes"]["phase_correlation_reason"] ==
          "phase_context_mismatch")

    completion_attributes = {
        "phase": "wake",
        "skill": "recall",
        "correlation": "exact",
        "lane_id_hash": exact_event["attributes"]["lane_id_hash"],
        "owner_id_hash": exact_event["attributes"]["owner_id_hash"],
        "lease_seconds": 30,
        "effect": "none",
        "phase_instance_id": context["CORTEX_PHASE_INSTANCE_ID"],
        "phase_start_run_id": context["CORTEX_PHASE_START_RUN_ID"],
    }
    old_event_file = os.environ.get("CORTEX_EVENTS_FILE")
    os.environ["CORTEX_EVENTS_FILE"] = ".cortex/events.jsonl"
    try:
        event_module.emit_event(
            "phase.completed",
            "ok",
            root=root,
            parent_run_id=context["CORTEX_PHASE_START_RUN_ID"],
            attributes=completion_attributes,
            inherit_phase_context=False,
        )
        event_module.emit_event(
            "phase.completed",
            "failed",
            root=root,
            parent_run_id=context["CORTEX_PHASE_START_RUN_ID"],
            attributes=completion_attributes,
            inherit_phase_context=False,
        )
    finally:
        if old_event_file is None:
            os.environ.pop("CORTEX_EVENTS_FILE", None)
        else:
            os.environ["CORTEX_EVENTS_FILE"] = old_event_file
    _, ordering = run(
        root,
        "reconcile", "--lane-id", "lane-context", "--owner-id", OWNER,
    )
    check("reconcile reports conflicting valid terminals",
          not ordering["ok"] and
          "conflicting_phase_terminal" in ordering["errors"])

print(f"\n{passed} passed, {failed} failed")
sys.exit(1 if failed else 0)
