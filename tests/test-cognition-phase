        (root / ".cortex/cognition-phase/owners").iterdir()
    )
    check("phase state and owner receipt are mode 0600",
          stat.S_IMODE(state.stat().st_mode) == 0o600 and
          stat.S_IMODE(owner_receipt.stat().st_mode) == 0o600)
    receipt = json.loads(owner_receipt.read_text())
