          expectation["environment"] == {
              "CORTEX_PHASE_RECEIPT_ID": expectation["receipt_id"],
          })
    first_status = subprocess.run(
        [
            str(TOOL), "status", "--receipt-id",
            expectation["receipt_id"],
        ],
