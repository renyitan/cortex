        [
            str(TOOL), "status", "--receipt-id",
            expectation["receipt_id"],
        ],
        env=environment(root),
        text=True,
        capture_output=True,
        check=False,
    )
    check("status JSON is deterministic",
          first_status.stdout == second_status.stdout)

    duplicate_process, duplicate = run(
        root,
        "complete", "--lane-id", "lane-basic", "--owner-id", OWNER,
        "--phase-instance-id", phase["phase_instance_id"],
        "--status", "ok",
