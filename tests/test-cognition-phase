with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    old = {
        key: os.environ.get(key)
        for key in (
            "CORTEX_REPO_ROOT", "CORTEX_EVENT_REPO_ROOT",
            "CORTEX_EVENTS_FILE", "CORTEX_PHASE_TIME",
            "CORTEX_EVENT_TIME", "CORTEX_PHASE_LEASE_SECONDS",
        )
    }
    os.environ.update(environment(root))
    original_save = phase_runtime._save_state

    def fail_cache_write(*_args, **_kwargs):
        raise phase_runtime.PhaseAdvisoryError(
            "phase_state_write_failed"
        )

    phase_runtime._save_state = fail_cache_write
    split = False
    try:
        phase_runtime.expect(
            root=root,
            lane_id="lane-split",
            owner_id=OWNER,
            receipt_id=None,
            phase="wake",
            skill="recall",
            trigger="session_start",
            origin="harness",
            requirement="required",
            enforcement="enforced",
            effect="none",
            if_absent=False,
        )
    except phase_runtime.PhaseAdvisoryError as exc:
        split = exc.code == "phase_state_write_failed"
    finally:
        phase_runtime._save_state = original_save
        for key, value in old.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value
    _, recovered = run(
        root,
        "reconcile", "--lane-id", "lane-split", "--owner-id", OWNER,
    )
    check("split write leaves authoritative event",
          split and len(events(root)) == 1)
    check("reconcile rebuilds cache after split write",
          len(recovered["expectations"]) == 1 and
          recovered["expectations"][0]["status"] == "pending")

    state_path = root / ".cortex/cognition-phase/state.json"
    cached = json.loads(state_path.read_text())
    lane_hash = recovered["lane_id_hash"]
    cached["lanes"][lane_hash]["expectations"][
        "33333333333333333333333333333333"
    ] = {
        "expectation_id": "33333333333333333333333333333333",
        "status": "pending",
    }
    state_path.write_text(json.dumps(cached))
    _, discarded = run(
        root,
        "reconcile", "--lane-id", "lane-split", "--owner-id", OWNER,
    )
    check("state without an event is discarded and reported",
          discarded["discarded_cache_entries"] == [
              "expectations:33333333333333333333333333333333"
          ])
    state_path.write_text("{not-json")
    _, corrupt_recovered = run(
        root,
        "reconcile", "--lane-id", "lane-split", "--owner-id", OWNER,
    )
    check("corrupt cache is discarded and rebuilt from events",
          corrupt_recovered["discarded_cache_entries"] == [
              "state:invalid"
          ] and len(corrupt_recovered["expectations"]) == 1)

