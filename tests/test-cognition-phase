          ) is not None and
          event_module.UUID_LIKE_RE.fullmatch(
              phase["phase_instance_id"]
          ) is not None and
          expectation["run_id"] != phase["run_id"] != completion["run_id"])
    check("exact terminal parents invocation command",
          lifecycle[-1]["event_type"] == "phase.completed" and
          lifecycle[-1]["parent_run_id"] == phase["phase_start_run_id"])
    check("start returns explicit runtime context",
          set(phase["environment"]) == {
              "CORTEX_PHASE_RECEIPT_ID",
              "CORTEX_PHASE_INSTANCE_ID", "CORTEX_PHASE_START_RUN_ID",
              "CORTEX_PHASE_NAME", "CORTEX_PHASE_SKILL",
