    _, expectation = expected(root, "lane-receipt-validation")
    receipt_id = expectation["receipt_id"]
    missing_process, missing = run(
        root,
        "status", "--receipt-id", "7" * 32,
    )
    mismatch_process, mismatch = run(
        root,
        "status", "--receipt-id", receipt_id,
        "--lane-id", "different-lane", "--owner-id", OWNER,
    )
    invalid_process = subprocess.run(
        [str(TOOL), "status", "--receipt-id", "not-a-uuid"],
        env=environment(root),
        text=True,
        capture_output=True,
        check=False,
    )
    env_process = subprocess.run(
        [str(TOOL), "status"],
        env=environment(root, CORTEX_PHASE_RECEIPT_ID=receipt_id),
        text=True,
        capture_output=True,
        check=False,
    )
    env_start = subprocess.run(
        [
            str(TOOL), "start",
            "--phase", "wake", "--skill", "recall",
            "--trigger", "session_start",
        ],
        env=environment(root, CORTEX_PHASE_RECEIPT_ID=receipt_id),
        text=True,
        capture_output=True,
        check=False,
    )
    check("missing receipt fails open with bounded reason",
          missing_process.returncode == 0 and not missing["ok"] and
          missing["reason_code"] == "phase_owner_receipt_not_found")
    check("mismatched receipt and explicit context are rejected",
          mismatch_process.returncode == 0 and not mismatch["ok"] and
          mismatch["reason_code"] == "phase_owner_receipt_mismatch")
    check("invalid receipt token exits nonzero",
          invalid_process.returncode == 2)
    check("receipt environment resolves lane and owner locally",
          env_process.returncode == 0 and
          json.loads(env_process.stdout)["receipt_id"] == receipt_id)
    check("later phase start accepts receipt environment only",
          env_start.returncode == 0 and
          json.loads(env_start.stdout)["receipt_id"] == receipt_id)

