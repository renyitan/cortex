#!/usr/bin/env python3
"""Observe successful cognition skill loads without retaining tool content."""
from __future__ import annotations

import hashlib
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from cognition_event import emit_event
from cognition_phase import session_identity

MAX_INPUT_BYTES = 64 * 1024
COGNITION_SKILLS = {"recall", "consolidate", "curate"}


def _read_payload() -> dict | None:
    raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
    if len(raw) > MAX_INPUT_BYTES:
        return None
    try:
        payload = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def main() -> int:
    payload = _read_payload()
    if payload is None:
        return 0
    if set(payload) != {
        "sessionId", "timestamp", "cwd", "toolName", "toolArgs", "toolResult"
    }:
        return 0
    if payload["toolName"] != "skill":
        return 0
    args = payload["toolArgs"]
    result = payload["toolResult"]
    if isinstance(args, str):
        try:
            args = json.loads(args)
        except json.JSONDecodeError:
            return 0
    if (
        not isinstance(args, dict)
        or set(args) != {"skill"}
        or args.get("skill") not in COGNITION_SKILLS
        or not isinstance(result, dict)
        or not {"resultType", "textResultForLlm"}.issubset(result)
        or result.get("resultType") != "success"
        or not isinstance(result.get("textResultForLlm"), str)
    ):
        return 0
    session_id = payload["sessionId"]
    if not isinstance(session_id, str) or not session_id:
        return 0

    root = Path(os.environ.get("COPILOT_PROJECT_DIR", os.getcwd())).resolve()
    lane_id, _ = session_identity(session_id)
    emit_event(
        "skill.loaded",
        "observed",
        root=root,
        component="phase",
        attributes={
            "skill": args["skill"],
            "correlation": "unavailable",
            "lane_id_hash": hashlib.sha256(
                lane_id.encode("utf-8")
            ).hexdigest(),
        },
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
