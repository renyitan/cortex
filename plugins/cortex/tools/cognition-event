#!/usr/bin/env python3
"""Append one content-minimal cortex cognition event."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from cognition_event import emit_event


def key_values(items: list[str], kind: str) -> dict:
    output = {}
    for item in items:
        if "=" not in item:
            raise ValueError(f"{kind} must be key=value")
        key, value = item.split("=", 1)
        if kind == "count":
            try:
                output[key] = int(value)
            except ValueError as exc:
                raise ValueError("count value must be an integer") from exc
        elif kind == "attribute" and value in ("true", "false"):
            output[key] = value == "true"
        elif kind == "attribute" and value.isdigit():
            output[key] = int(value)
        else:
            output[key] = value
    return output


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="cognition-event")
    subparsers = parser.add_subparsers(dest="command", required=True)
    emit = subparsers.add_parser("emit")
    emit.add_argument("event")
    emit.add_argument("status")
    emit.add_argument("--run-id")
    emit.add_argument("--parent-run-id")
    emit.add_argument("--duration-ms", type=int)
    emit.add_argument("--reason-code")
    emit.add_argument("--phase-instance-id")
    emit.add_argument("--phase-start-run-id")
    emit.add_argument("--phase")
    emit.add_argument("--skill")
    emit.add_argument("--phase-lane-id")
    emit.add_argument("--phase-owner-id")
    emit.add_argument("--phase-receipt-id")
    emit.add_argument("--ref", action="append", default=[])
    emit.add_argument("--count", action="append", default=[])
    emit.add_argument("--hash", action="append", default=[])
    emit.add_argument("--attribute", action="append", default=[])
    emit.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    try:
        counts = key_values(args.count, "count")
        hashes = key_values(args.hash, "hash")
        attributes = key_values(args.attribute, "attribute")
    except ValueError as exc:
        print(f"cognition-event: {exc}", file=sys.stderr)
        return 2

    payload, reason = emit_event(
        args.event,
        args.status,
        run_id=args.run_id,
        parent_run_id=args.parent_run_id,
        duration_ms=args.duration_ms,
        reason_code=args.reason_code,
        phase_instance_id=args.phase_instance_id,
        phase_start_run_id=args.phase_start_run_id,
        phase=args.phase,
        skill=args.skill,
        phase_lane_id=args.phase_lane_id,
        phase_owner_id=args.phase_owner_id,
        phase_receipt_id=args.phase_receipt_id,
        refs=args.ref,
        counts=counts,
        hashes=hashes,
        attributes=attributes,
    )
    if reason == "disabled":
        return 0
    if reason is not None:
        print(f"cognition-event: append failed (reason: {reason})", file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
